# =============================================================================
# GreenGru frontend — copy to .env
#   cp .env.example .env          (macOS/Linux)
#   copy .env.example .env        (Windows)
# =============================================================================
#
# Only one variable is needed for New Submission OCR right now:


# Backend FastAPI URL (must match where uvicorn runs).
# Used in production builds; in `npm run dev` the Vite proxy is used instead.
VITE_API_URL=http://localhost:8000

# Optional: override the Vite → backend proxy target (dev only).
# Useful when 127.0.0.1:8000 is occupied by another app while Carbon Passport
# listens on 0.0.0.0:8000 or a different port (e.g. http://127.0.0.1:8001).
# VITE_DEV_API_PROXY=http://127.0.0.1:8001

# No Supabase or Qwen keys go in the frontend — those live in backend/.env only.
